<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same secrets store as the API, so the Gemini key only has to be set once. -->
    <UserSecretsId>8ba0f654-bd6e-4f26-8a6c-b4131e17c5dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scopewise.Interview\Scopewise.Interview.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Personas\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
